# Copy this file to .env and adjust as needed:  cp .env.example .env

# ─── Database ────────────────────────────────────────────────────────────────
# The app supports two database engines from a single Prisma schema. The engine
# is chosen automatically from the URL shape:
#   file:        -> SQLite   (default; zero setup, good for single-user)
#   postgres://  -> PostgreSQL (opt-in; for users who want it)
#
# Default: local SQLite file. ./data is also the self-host volume mount point.
DATABASE_URL="file:./data/app.db"

# To use PostgreSQL instead, comment the line above and set a postgres URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskmanager?schema=public"

# ─── First-time setup ────────────────────────────────────────────────────────
# After copying this file and applying migrations, optionally load some example
# categories and tasks to work with:
#   npm run db:migrate   # apply migrations to the database above
#   npm run db:seed      # populate example data (safe to re-run; idempotent)
