# Copy this file to .env and adjust as needed:  cp .env.example .env

# ─── Database ────────────────────────────────────────────────────────────────
# The app supports two database engines from a single Prisma schema. The engine
# is chosen automatically from the URL shape:
#   file:        -> SQLite   (default; zero setup, good for single-user)
#   postgres://  -> PostgreSQL (opt-in; for users who want it)
#
# Default: local SQLite file. ./data is also the self-host volume mount point.
DATABASE_URL="file:./data/app.db"

# To use PostgreSQL instead, comment the line above and set a postgres URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vecta?schema=public"

# Docker volume the compose files' PostgreSQL opt-in keeps its data in. Unset
# means vecta_db-data. Set it for the same reasons as VECTA_DATA_VOLUME below.
# VECTA_DB_VOLUME=vecta_db-data


# ─── First-time setup ────────────────────────────────────────────────────────
# After copying this file and applying migrations, optionally load some example
# categories and tasks to work with:
#   npm run db:migrate   # apply migrations to the database above
#   npm run db:seed      # populate example data (safe to re-run; idempotent)


# ─── Session and Authentication ──────────────────────────────────────────────
# Both these fields are required to run the application

# Single-User Admin Password
ADMIN_PASSWORD="PASSWORD"

# 32-Character Session Secret
# Can be generated using:
#   openssl rand -hex 32
SESSION_SECRET="SESSION-SECRET-RAND-32-123456789"


# ─── Logging ─────────────────────────────────────────────────────────────────
# The least severe level of server entry that is logged, to stdout and to the
# app's Log table: debug, info, warn or error. Unset means info. Changes to your
# tasks and categories, and sign-ins, are recorded whatever this is set to. Any
# other value stops the app from starting, so a typo cannot silently change what
# is recorded.
# LOG_LEVEL=info


# ─── Time zone ───────────────────────────────────────────────────────────────
# The server's time zone, as a name such as Europe/London. Old log entries are
# deleted every night at 03:00 in this zone, and the Logs page writes its dates
# and times in it. Unset means UTC in the Docker image, and this machine's own
# zone when running outside Docker.
# TZ=Europe/London


# ─── Remote dev access ───────────────────────────────────────────────────────
# Extra hostnames allowed to reach the DEV server (comma-separated). Only needed
# when reaching `npm run dev` from outside the LAN, e.g. via a tunnel. Hostname
# only - no scheme, no port. Ignored in production builds.
# ALLOWED_DEV_ORIGINS="dev.example.com,*.trycloudflare.com"


# ─── Self-hosting with Docker ────────────────────────────────────────────────
# Host port the compose files publish the app on. The container always listens
# on 3000; this only moves the host side, so change it when 3000 is already
# taken. Unused outside Docker — `npm run dev` is not affected.
# PORT=3000

# Override the DATABASE_URL above with the container's absolute data path. The
# compose files already set this, so it is here for `docker run` users only:
#   DATABASE_URL="file:/app/data/app.db"

# Image tag docker-compose.prod.yml runs. Unset means `latest`, which moves on
# every non-prerelease release. Pin it to control when you upgrade.
# VECTA_VERSION=v1.0.0

# Docker volume the compose files keep the SQLite database in. Unset means
# vecta_app-data, whichever folder you run Compose from. Set it in two cases:
#   - Your install already keeps its data in a volume of another name. Installs
#     made before the name was fixed are named after their folder, as
#     <folder>_app-data; `docker volume ls` lists them. Set it before upgrading,
#     or the app starts on a new, empty volume.
#   - You run a second install on the same host. Without its own name, both
#     would open the same database.
# VECTA_DATA_VOLUME=vecta_app-data
