// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// provider is patched to match DATABASE_URL by scripts/resolve-provider.mjs
// (runs before every Prisma command). The committed default is SQLite.
// The connection url is injected from DATABASE_URL via prisma.config.ts.
datasource db {
  provider = "sqlite"
}


// Models below are shared by both providers. Per ARCHITECTURE.md (Data model): stick
// to String/Int/DateTime/Boolean only — no Json/Jsonb or native UUID types — so the
// one schema compiles to both SQLite and Postgres.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  status      String    // "open" | "in_progress" | "closed" — enum-as-string for SQLite compat
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dueAt       String?   // "YYYY-MM-DD" or "YYYY-MM-DDTHH:MM": local wall-clock time, no timezone
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#3b9eff") // CATEGORY_PALETTE[0]; see src/lib/palette.ts
  tasks     Task[]
  createdAt DateTime @default(now())
}

// One recorded event: something that happened on the server ("operational"),
// or a change the user made to their data ("activity"). Both kinds share a
// table so they can be listed, exported and aged out in one place.
//
// There is deliberately no relation to Task or Category. An entry must outlive
// the row it describes ("task deleted" would otherwise vanish with the task),
// so any ids it refers to are kept in `detail`.
model Log {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  kind      String    // "operational" | "activity", checked on write by the log service
  level     String    // "debug" | "info" | "warn" | "error"
  event     String    // A stable machine-readable name, e.g. "task.deleted"
  message   String    // A human-readable line
  detail    String?   // A JSON object, serialised on write and parsed on read by the log service

  @@index([createdAt])        // Retention deletes and the newest-first listing
  @@index([kind, createdAt])  // One kind, newest first
}
